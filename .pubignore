# Kept out of the published package (a .pubignore here replaces .gitignore's
# rules for this folder, so those are repeated).

# From .gitignore.
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/
*.iml
*.ipr
*.iws
.idea/
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/
/*_example/

# Research evidence and the README's images, which pub.dev loads from the
# repository; only the screenshots are shipped.
/doc/comparison/
/doc/images/*
!/doc/images/hero.png
!/doc/images/bar-features.png
